# Server configuration — copy to .env or export before `node server/index.mjs`,
# or set these in docker-compose.yml.

# Optional shared fallback for every signed-in user. Users can instead add
# their own key from Settings. Leave blank on an open multi-user server.
ANTHROPIC_API_KEY=

# Optional: Claude model for AI features (default: claude-opus-5)
AI_MODEL=claude-opus-5

# Account creation: open | first-user | disabled
REGISTRATION_MODE=open

# Required only when creating the first account. Leave blank to generate a
# random token in data/.bootstrap-token and print it in the server startup log,
# or choose a long random value here before the first start.
BOOTSTRAP_TOKEN=

# Session-cookie Secure flag: auto | true | false. "auto" enables it for
# direct HTTPS or when a reverse proxy sends X-Forwarded-Proto: https.
COOKIE_SECURE=auto

# Optional stable secrets. If SESSION_SECRET is blank, the server creates
# data/.session-secret and persists it with the rest of the data volume.
# Set both before saving UI API keys if you prefer externally managed secrets.
SESSION_SECRET=
SETTINGS_ENCRYPTION_KEY=

# Optional: where the JSON data files live (default: ./data, docker: /data)
DATA_DIR=./data

# Optional: HTTP port (default: 8720)
PORT=8720
