# Copy this to .env and fill in your own values. Never commit .env.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe — public key only (safe to ship)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_xxx
VITE_STRIPE_PRICE_PRO_MONTHLY=price_xxx
VITE_STRIPE_PRICE_PRO_YEARLY=price_xxx

# URL of the deployed app (used for Stripe checkout return URLs)
VITE_APP_URL=http://localhost:5174
